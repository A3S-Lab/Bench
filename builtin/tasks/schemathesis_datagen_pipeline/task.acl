# Third-party source details: ../../provenance/edgebench.json
bench "schemathesis_datagen_pipeline" {
  schema  = "a3s-bench/task/v2"
  version = "0.1.0"

  name        = "Schemathesis Datagen Pipeline"
  category    = "Systems & Software Engineering"
  description = "Complete the task described in public/prompt.md."

  workspace {
    oci {
      ref         = "docker.io/seededge/edgebench.work.schemathesis_datagen_pipeline:b52953fc6612"
      platform    = "linux/amd64"
      source_path = "/app"
    }
  }

  work {
    cpu_limit    = 4
    memory_bytes = 17179869184
    https_allow_hosts = [
      "files.pythonhosted.org",
      "pypi.org",
    ]

    image {
      ref = "docker.io/seededge/edgebench.work.schemathesis_datagen_pipeline:b52953fc6612"
    }
    network_need = "restricted_https"
  }

  submission {
    include = [
      ".",
    ]
    exclude = [
      ".git",
      "__pycache__",
      "*.pyc",
      "*.egg-info",
      ".eggs",
      "*.so",
      "TODO.md",
    ]
  }

  judge {
    asset                = "private/judge"
    solution_timeout_sec = 43200
    cpu_limit            = 4
    memory_bytes          = 8589934592
  }

  metric "score" {
    type                   = "ratio"
    role                   = "primary"
    direction              = "maximize"
    min                    = 0
    max                    = 1
    normalization          = "linear_range_v1"
    solution_failure_value = "0"
    public_report          = true
  }
}
